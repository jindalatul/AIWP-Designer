{
  "name": "aiwp/aiwp-designer",
  "description": "AI-native website design system for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "AIWP\\Designer\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test:all": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "optimize-autoloader": true
  }
}
